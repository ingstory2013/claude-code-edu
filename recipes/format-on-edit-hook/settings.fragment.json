{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // empty'); [ -n \"$file\" ] && [ -f \"$file\" ] && npx --no-install prettier --write \"$file\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
